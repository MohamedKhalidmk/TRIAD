# TRIAD backend settings. dev.sh copies this file to .env if .env does not exist.
# You can also copy it yourself: cp src/backend/.env.example src/backend/.env
#
# Git ignores .env. Put your API keys only in .env, never in this file.
# A variable of the shell wins over .env. An empty value has no effect, so the default stays.
# After you change .env, stop dev.sh (Ctrl+C) and start it again.

# The chat mode: fake (no network, no key) or llm (LiteLLM calls the model below).
# The llm mode also needs: uv pip install --python .venv/bin/python -r requirements-llm.txt
TRIAD_LLM=fake

# The LiteLLM model of the llm mode. Gemini has a free tier.
# For Claude, use anthropic/claude-opus-5-5 and set ANTHROPIC_API_KEY.
TRIAD_LLM_MODEL=gemini/gemini-3.8-flash

# The API key of the provider of TRIAD_LLM_MODEL. Only LiteLLM reads it.
# Get a Gemini key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings.
# The clock. The default is "system": the clock of the computer, in its local time zone.
# A fixed ISO 8601 time gives the fixed demo time (the tests, the screenshots and the report use it):
# TRIAD_NOW=2026-10-30T09:00:00-04:00
# The SQLite database. A relative path starts at the root folder of the repository.
# TRIAD_DB_PATH=src/backend/data/triad.db
