tStyle=4;" vertex="1" parent="1"><mxGeometry x="2957" y="1630" width="126" height="40" as="geometry"/></mxCell><mxCell id="c255" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c249" target="c254"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c256" value="Name" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2934" y="1690" width="112" height="40" as="geometry"/></mxCell><mxCell id="c257" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c249" target="c256"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c258" value="Form" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2564" y="1740" width="112" height="40" as="geometry"/></mxCell><mxCell id="c259" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c249" target="c258"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c260" value="Manufacturer" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2758" y="1750" width="144" height="40" as="geometry"/></mxCell><mxCell id="c261" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c249" target="c260"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c262" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Box: entity. Double box: weak entity.&lt;br&gt;Diamond: relationship. Double diamond: identifying relationship.&lt;br&gt;Oval: attribute. Double oval: multivalued attribute.&lt;br&gt;Solid underline: key. Dashed underline: partial key.&lt;br&gt;Triangle (ISA): subtypes; it points toward the subtypes.&lt;br&gt;Crow&#x27;s feet: two bars = exactly one; circle and bar = zero or one;&lt;br&gt;circle and crow&#x27;s foot = zero or many; bar and crow&#x27;s foot = one or many.&lt;br&gt;Grey: TRIAD contribution (authorship, revision, agent layer).&lt;br&gt;&lt;i&gt;Identifier&lt;/i&gt; = System + Value (composite, the FHIR Identifier).&lt;br&gt;&lt;i&gt;Address&lt;/i&gt; = Street, City, Region, PostalCode, Country (composite).&lt;br&gt;Page 2 shows the agent layer, care teams, the audit log and the lineage store." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="600" height="252" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Agent layer, care teams, audit and lineage" id="page1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="2900" pageHeight="1900" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;TRIAD ER diagram, page 2: agent layer, care teams, audit and lineage&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Staff" style="rounded=0;fontStyle=1;fontSize=19;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;dashed=1;" vertex="1" parent="1"><mxGeometry x="210" y="292" width="180" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Message" style="rounded=0;fontStyle=1;fontSize=19;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;dashed=1;" vertex="1