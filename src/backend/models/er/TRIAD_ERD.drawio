></mxCell><mxCell id="c312" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c309" target="c311"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c313" value="Identifier" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="927" y="210" width="126" height="40" as="geometry"/></mxCell><mxCell id="c314" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c309" target="c313"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c315" value="Subject" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="958" y="520" width="104" height="40" as="geometry"/></mxCell><mxCell id="c316" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c296" target="c315"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c317" value="Name" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1098" y="540" width="104" height="40" as="geometry"/></mxCell><mxCell id="c318" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c315" target="c317"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c319" value="DateOfBirth" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="932" y="590" width="135" height="40" as="geometry"/></mxCell><mxCell id="c320" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c315" target="c319"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c321" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Box: entity. Double box: weak entity.&lt;br&gt;Diamond: relationship. Double diamond: identifying relationship.&lt;br&gt;Oval: attribute. Double oval: multivalued attribute.&lt;br&gt;Ovals on an oval: composite attribute.&lt;br&gt;Solid underline: key. Dashed underline: partial key.&lt;br&gt;Triangle (ISA): subtypes; it points toward the subtypes.&lt;br&gt;Crow&#x27;s feet: two bars = exactly one; circle and bar = zero or one;&lt;br&gt;circle and crow&#x27;s foot = zero or many; bar and crow&#x27;s foot = one or many.&lt;br&gt;Grey: TRIAD contribution (authorship, revision, agent layer).&lt;br&gt;&lt;i&gt;Identifier&lt;/i&gt; = System + Value (composite, the FHIR Identifier).&lt;br&gt;&lt;i&gt;Address&lt;/i&gt; = Street, City, Region, PostalCode, Country (composite).&lt;br&gt;The diagram is a tree: one path between any two entity sets.&lt;br&gt;Chat sessions and audit records are logs. User, Actor and Subject are values,&lt;br&gt;so they stay correct when a row changes and they add no loop.&lt;br&gt;CareTeam.Member keeps the staff Identifier as a value (a FHIR reference by identifier)." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="1640" width="610" height="328" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
