Arrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c57" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="Subject" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1168" y="1140" width="104" height="40" as="geometry"/></mxCell><mxCell id="c64" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c44" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="Name" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1348" y="1140" width="104" height="40" as="geometry"/></mxCell><mxCell id="c66" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c63" target="c65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value="DateOfBirth" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1342" y="1200" width="135" height="40" as="geometry"/></mxCell><mxCell id="c68" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c63" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c69" value="Chat sessions and audit records are logs. They keep the user and the patient as values&lt;br&gt;(User, Actor, Subject). The values stay correct when a row changes, and they add no loop." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Lineage store&lt;/b&gt; (physical layer). It keeps every source FHIR resource as it came in,&lt;br&gt;so TRIAD can link to any FHIR server with almost no data loss. Each mapped row keeps&lt;br&gt;the value FhirRef (ResourceType/LogicalId/VersionId) of its source resource." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1640" y="80" width="900" height="80" as="geometry"/></mxCell><mxCell id="c71" value="FhirSource" style="rounded=0;fontStyle=1;fontSize=19;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1910" y="302" width="180" height="56" as="geometry"/></mxCell><mxCell id="c72" value="Holds
Resource" style="rhombus;double=1;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1925" y="524" width="150" height="72" as="geometry"/></mxCell><mxCell id="c73" value="FhirResource" style="shape=ext;double=1;margin=4;rounded=0;fontStyle=1;fontSize=19;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1910" y="762" width="180" height="56" as="geometry"/></mxCell><mxCell id="c74" value="" style="endArrow=ERmandOne;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c72" target="c71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c75" value="" style="endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c72" target="c73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c76" value="Name" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1768" y="230" width="104" height="40" as="geometry"/></mxCell><mxCell id="c77" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c71" target="c76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c78" value="BaseUrl" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2128" y="230" width="104" height="40" as="geometry"/></mxCell><mxCell id="c79" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c71" target="c78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c80" value="FhirVersion" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2152" y="300" width="135" height="40" as="geometry"/></mxCell><mxCell id="c81" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c71" target="c80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c82" value="RetrievedAt" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2132" y="370" width="135" height="40" as="geometry"/></mxCell><mxCell id="c83" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c71" target="c82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c84" value="Sha256" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1748" y="380" width="104" height="40" as="geometry"/></mxCell><mxCell id="c85" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c71" target="c84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c86" value="&lt;span style=&quot;border-bottom:1px dashed #000000;&quot;&gt;ResourceType&lt;/span&gt;" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1708" y="680" width="144" height="40" as="geometry"/></mxCell><mxCell id="c87" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c73" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c88" value="&lt;span style=&quot;border-bottom:1px dashed #000000;&quot;&gt;LogicalId&lt;/span&gt;" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1732" y="770" width="117" height="40" as="geometry"/></mxCell><mxCell id="c89" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c73" target="c88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c90" value="&lt;span style=&quot;border-bottom:1px dashed #000000;&quot;&gt;VersionId&lt;/span&gt;" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1742" y="860" width="117" height="40" as="geometry"/></mxCell><mxCell id="c91" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c73" target="c90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c92" value="LastUpdated" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2152" y="720" width="135" height="40" as="geometry"/></mxCell><mxCell id="c93" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c73" target="c92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c94" value="Json" style="ellipse;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2158" y="820" width="104" height="40" as="geometry"/></mxCell><mxCell id="c95" value="" style="endArrow=none;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c73" target="c94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c96" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Box: entity. Double box: weak entity.&lt;br&gt;Diamond: relationship. Double diamond: identifying relationship.&lt;br&gt;Oval: attribute. Double oval: multivalued attribute.&lt;br&gt;Ovals on an oval: composite attribute.&lt;br&gt;Solid underline: key. Dashed underline: partial key.&lt;br&gt;Triangle (ISA): subtypes; it points toward the subtypes.&lt;br&gt;Crow&#x27;s feet: two bars = exactly one; circle and bar = zero or one;&lt;br&gt;circle and crow&#x27;s foot = zero or many; bar and crow&#x27;s foot = one or many.&lt;br&gt;Grey: TRIAD contribution (authorship, revision, agent layer).&lt;br&gt;&lt;i&gt;Identifier&lt;/i&gt; = System + Value (composite, the FHIR Identifier).&lt;br&gt;&lt;i&gt;Address&lt;/i&gt; = Street, City, Region, PostalCode, Country (composite).&lt;br&gt;The diagram is a tree: one path between any two entity sets.&lt;br&gt;Dashed box: a copy of an entity from page 1." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1"><mxGeometry x="1640" y="1000" width="610" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
