e (composite, the FHIR Identifier).&lt;br&gt;&lt;i&gt;Address&lt;/i&gt; = Street, City, Region, PostalCode, Country (composite).&lt;br&gt;The diagram is a tree: one path between any two entity sets.&lt;br&gt;Page 2 shows the agent layer, the audit log and the lineage store." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="1640" width="610" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Agent layer, audit and lineage" id="page1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="2600" pageHeight="1500" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;TRIAD ER diagram, page 2: agent layer, audit log and lineage store&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Assertion" style="shape=ext;double=1;margin=4;rounded=0;fontStyle=1;fontSize=19;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#E6E6E6;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="612" width="180" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Cites" style="rhombus;fontSize=15;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#E6E6E6;" vertex="1" parent="1"><mxGeometry x="565" y="604" width="150" height="72" as="geometry"/></mxCell><mxCell id="c4" value="ChatTurn" style="shape=ext;double=1;margin=4;rounded=0;fontStyle=1;fontSize=19;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fillColor=#E6E6E6;" vertex="1" parent="1"><mxGeometry x="870" y="612" width="180" height="56" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#000000;fontSize=15