    [ a owl:Restriction ; owl:onProperty triad:priority ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

triad:LabReport rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty triad:issuedDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

triad:Medication rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty triad:code ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:codeSystem ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:name ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

triad:Prescription rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty triad:prescriptionStatus ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

triad:CareTeam rdfs:subClassOf
