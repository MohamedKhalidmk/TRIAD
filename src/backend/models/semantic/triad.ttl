triad:AuditEvent rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty triad:identifierSystem ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:identifierValue ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:at ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:action ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:auditOutcome ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:actorRole ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:actorSystem ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:actorValue ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:subjectName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:subjectDateOfBirth ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:path ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

# =============================================================================
# Keys (owl:hasKey): the candidate keys (UNIQUE) of the DDL
# =============================================================================
# Two named individuals of the class with the same key values are the same individual (owl:sameAs).
# This is not an error. SHACL, 05_constraint_checks.sparql and the app guards find duplicate keys.

triad:Department owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:Location owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:Staff owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:Visit owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:ClinicalEntry owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:Message owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:ChatSession owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:AuditEvent owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:Patient owl:hasKey ( triad:name triad:dateOfBirth ) .
triad:PatientIdentifier owl:hasKey ( triad:identifierSystem triad:identifierValue ) .
triad:Medication owl:hasKey ( triad:code triad:codeSystem ) .
# The weak entities: the owner (through the named inverse) and the partial key.
triad:Assertion owl:hasKey ( triad:inMessage triad:seq ) .
triad:ChatTurn owl:hasKey ( triad:inSession triad:seq ) , ( triad:inSession triad:clientTurnId ) .
# The association classes and the value class CareTeamMember.
triad:WorksIn owl:hasKey ( triad:ofStaff triad:atDepartment triad:roleCode ) .
triad:VisitLocation owl:hasKey ( triad:ofVisit triad:atLocation triad:startDate ) .
triad:Citation owl:hasKey ( triad:byTurn triad:citedAssertion ) .
triad:CareTeamMember owl:hasKey ( triad:memberOf triad:memberSystem triad:memberValue ) .

# =============================================================================
# Alignment: PROV-O (declared here, not imported) and FHIR R4
# =============================================================================

# PROV-O terms. TRIAD does not use owl:imports: these declarations are a local copy of the PROV-O terms.
prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "PROV-O: a thing with a fixed form, for example a message or a claim. TRIAD declares this term here and does not import PROV-O."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "PROV-O: a thing that is responsible for an activity or an entity. TRIAD declares this term here and does not import PROV-O."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:Person a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "Person"@en ;
    rdfs:comment "PROV-O: an agent that is a person. TRIAD declares this term here and does not import PROV-O."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent ;
    rdfs:label "was attributed to"@en ;
    rdfs:comment "PROV-O: the agent that is responsible for the entity. TRIAD declares this term here and does not import PROV-O."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:wasRevisionOf a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity ;
    rdfs:label "was revision of"@en ;
    rdfs:comment "PROV-O: the entity is a revised version of the other entity. TRIAD declares this term here and does not import PROV-O."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

# A message and an assertion are PROV entities. A staff member is a PROV person.
triad:Message rdfs:subClassOf prov:Entity .
triad:Assertion rdfs:subClassOf prov:Entity .
triad:Staff rdfs:subClassOf prov:Person .

# The new assertion is a revision of the old one. The issuer and the author are the responsible agents.
triad:supersedes rdfs:subPropertyOf prov:wasRevisionOf .
triad:issuedBy rdfs:subPropertyOf prov:wasAttributedTo .
triad:assertedBy rdfs:subPropertyOf prov:wasAttributedTo .

# FHIR R4 (http://hl7.org/fhir/, the namespace of the FHIR R4 Turtle). The ER README section 5 gives the matches.
triad:Department skos:closeMatch fhir:Organization .
triad:Location skos:closeMatch fhir:Location .
triad:Staff skos:closeMatch fhir:Practitioner .
triad:WorksIn skos:closeMatch fhir:PractitionerRole .
triad:Patient skos:closeMatch fhir:Patient .
triad:PatientIdentifier skos:closeMatch fhir:Identifier .
triad:Visit skos:closeMatch fhir:Encounter .
triad:Diagnosis skos:closeMatch fhir:Condition .
triad:Procedure skos:closeMatch fhir:Procedure .
triad:Allergy skos:closeMatch fhir:AllergyIntolerance .
triad:Observation skos:closeMatch fhir:Observation .
triad:LabOrder skos:closeMatch fhir:ServiceRequest .
triad:LabReport skos:closeMatch fhir:DiagnosticReport .
triad:Prescription skos:closeMatch fhir:MedicationRequest .
triad:CareTeam skos:closeMatch fhir:CareTeam .
triad:Medication skos:closeMatch fhir:Medication .
triad:Message skos:closeMatch fhir:Communication ;
    skos:relatedMatch fhir:DocumentReference .
# An assertion is one claim, and a FHIR Provenance describes one resource version: related, not close.
triad:Assertion skos:relatedMatch fhir:Provenance .
triad:AuditEvent skos:closeMatch fhir:AuditEvent .
# ClinicalEntry, the Staff subtypes, VisitLocation, CareTeamMember and the agent layer
# (ChatSession, ChatTurn, Citation) have no FHIR R4 resource of their own.
