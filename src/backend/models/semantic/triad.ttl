triad:CareTeamMember rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty triad:memberSystem ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:memberValue ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

triad:Message rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty triad:identifierSystem ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:identifierValue ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:channel ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:origin ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:sentAt ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty triad:text ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

triad:Assertion rdfs:subClassOf
