/ inMessage" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o19" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o53" value="during (F)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o10" target="o27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o54" value="hasVisit (IF)
/ visitOf" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o22" target="o27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o55" value="identifier (IF)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o22" target="o23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o56" value="inTurn (F)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o4" target="o8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o57" value="includes (IF)
/ inSession" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o7" target="o8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o58" value="issues (IF)
/ issuedBy" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o26" target="o19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o59" value="member (IF)
/ memberOf" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o5" target="o6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o60" value="ofStaff (F)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o29" target="o26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o61" value="ofVisit (F)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o28" target="o27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o62" value="prescribes (F)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o24" target="o18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o63" value="supersedes (F, IF, Asym, Irr)" style="endArrow=block;endFill=1;endSize=10;strokeColor=#000000;strokeWidth=1.5;fontStyle=2;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o3" target="o3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1458" y="1008"/><mxPoint x="1542" y="1008"/></Array></mxGeometry></mxCell><mxCell id="o64" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Box: class (owl:Class). Yellow box: association class (an M:N relationship with attributes).&lt;br&gt;Green box: value class (one value of a multivalued composite attribute).&lt;br&gt;Black arrow: a stored object property, from its domain to its range.&lt;br&gt;(F) Functional, (IF) InverseFunctional, (Asym) Asymmetric, (Irr) Irreflexive.&lt;br&gt;&amp;quot;/ name&amp;quot;: the named inverse (no triples in the store; the keys and the chains use it).&lt;br&gt;&lt;span style=&quot;color:#1F5FA8;&quot;&gt;Blue line with a hollow head: rdfs:subClassOf. The triangle: owl:disjointUnionOf (disjoint, total).&lt;/span&gt;&lt;br&gt;The 16 stored properties (without supersedes) and the 11 subclass links make a tree.&lt;br&gt;&lt;b&gt;Derived properties&lt;/b&gt; (OWL 2 property chains; a reasoner infers them):&lt;br&gt;assertedBy = inMessage ∘ issuedBy (Assertion → Staff, ⊑ prov:wasAttributedTo);&lt;br&gt;ofPatient = about ∘ during ∘ visitOf (Assertion → Patient);&lt;br&gt;supersedesTransitively: transitive, supersedes ⊑ it.&lt;br&gt;&lt;b&gt;Reused vocabularies&lt;/b&gt; (declared locally, no owl:imports):&lt;br&gt;PROV-O: Message, Assertion ⊑ prov:Entity; Staff ⊑ prov:Person;&lt;br&gt;supersedes ⊑ prov:wasRevisionOf; issuedBy, assertedBy ⊑ prov:wasAttributedTo.&lt;br&gt;FHIR R4: ≈ skos:closeMatch, ~ skos:relatedMatch (namespace http://hl7.org/fhir/).&lt;br&gt;The datatype properties, keys and restrictions are in ontology.md (sections 4 to 6)." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="1560" width="690" height="309" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
