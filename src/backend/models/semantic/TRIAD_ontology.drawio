<mxfile host="build_figure.py" type="device"><diagram name="TRIAD ontology" id="ontology"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="3300" pageHeight="2080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o1" value="&lt;b&gt;TRIAD ontology (Milestone 5): the classes and the object properties&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="30" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;Allergy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444;&quot;&gt;≈ fhir:AllergyIntolerance&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=17;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2628" y="440" width="224" height="60" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Assertion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444;&quot;&gt;⊑ prov:Entity&lt;br&gt;~ fhir:Provenance&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=17;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1415" y="862" width="170" height="76" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b&gt;AuditEvent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444;&quot;&gt;≈ fhir:AuditEvent&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=17;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="855" y="390" width="170" height="60" as="geometry"/></mxCell><mxCell id="o5" value="&lt;b&gt;CareTeam&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444;&quot;&gt;≈ fhir:CareTeam&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=17;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"