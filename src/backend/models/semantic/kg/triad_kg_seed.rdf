  <identifierSystem xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">https://triad.example/fhir/sid/message</identifierSystem>
  <identifierValue xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">MSG-ELENA-2026-10-02</identifierValue>
  <origin xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Staff</origin>
  <sentAt xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-02T11:40:00-04:00</sentAt>
  <text xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Visit note. The penicillin skin test and the oral challenge are negative. The patient is not allergic to penicillin.</text>
</rdf:Description>
