  <text xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Records copied from Lakeside Family Clinic. The records list a penicillin allergy.</text>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/kg/message/3">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
