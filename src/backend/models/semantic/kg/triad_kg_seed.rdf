  <text xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Phone call. The patient says that she had a rash after penicillin as a child.</text>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/kg/message/2">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
