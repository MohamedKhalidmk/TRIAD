  <origin xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Lab</origin>
  <sentAt xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-22T16:00:00-04:00</sentAt>
  <text xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Lipid panel result received. LDL cholesterol is 112 mg/dL.</text>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/kg/message/5">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
