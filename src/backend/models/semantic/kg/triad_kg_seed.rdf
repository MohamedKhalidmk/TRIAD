  <identifierValue xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">MSG-ELENA-2025-08-20</identifierValue>
  <origin xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Staff</origin>
  <sentAt xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#" rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-20T10:05:00-04:00</sentAt>
  <text xmlns="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#">Visit note. Blood pressure is high on two readings. Diagnosis: essential hypertension. Start amlodipine 5 mg daily. Order a lipid panel.</text>
</rdf:Description>
