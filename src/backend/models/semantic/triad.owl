  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b115"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b116"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#WorksIn">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">One role of one staff member in one department. It holds the role code, the specialty and the dates. The ER relationship WorksIn becomes this class, because the relationship has attributes.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
