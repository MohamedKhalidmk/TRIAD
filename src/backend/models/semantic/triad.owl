  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#relatedMatch">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">PROV-O: a thing that is responsible for an activity or an entity. TRIAD declares this term here and does not import PROV-O.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Agent</label>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">PROV-O: a thing with a fixed form, for example a message or a claim. TRIAD declares this term here and does not import PROV-O.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Entity</label>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/ns/prov#Person">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">PROV-O: an agent that is a person. TRIAD declares this term here and does not import PROV-O.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Person</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"/>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">PROV-O: the agent that is responsible for the entity. TRIAD declares this term here and does not import PROV-O.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">was attributed to</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"/>
</rdf:Description>
<rdf:Description rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">PROV-O: the entity is a revised version of the other entity. TRIAD declares this term here and does not import PROV-O.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov-o#"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">was revision of</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Allergy">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A clinical entry that records an allergy or an intolerance.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Allergy</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ClinicalEntry"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b1"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/AllergyIntolerance"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">One claim of a message about one clinical entry. It is a weak entity: its message and its sequence number identify it. A new assertion can supersede an old one. The current record is the set of assertions that no assertion supersedes.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Assertion</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b10"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b2"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b3"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b4"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b5"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b6"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b7"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b8"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b9"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b11"/>
  <relatedMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/Provenance"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#AuditEvent">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A record of one access to the data of a patient, or of one denied access. It is a log: it keeps the actor and the patient as values, not as links.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Audit event</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b12"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b13"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b14"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b15"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b16"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b17"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b18"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b19"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b20"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b21"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b22"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b23"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/AuditEvent"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeam">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A clinical entry that lists the staff members who care for the patient. Only a member of a current, active care team can open the chart.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Care team</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ClinicalEntry"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b24"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/CareTeam"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeamMember">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">One member of a care team. It keeps the identifier of the staff member as a value (a FHIR reference by identifier), so it adds no loop to the tree.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Care team member</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b25"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b26"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b27"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b28"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatSession">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A conversation of one user with the Care Assistant about one patient. It is a log: it keeps the user and the patient as values, not as links.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Chat session</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b29"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b30"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b31"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b32"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b33"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b34"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b35"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b36"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b37"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b38"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatTurn">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">One turn of a chat session: a question of the user or an answer of the assistant. It is a weak entity: its session and its sequence number identify it.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Chat turn</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b39"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b40"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b41"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b42"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b43"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b44"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b45"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b46"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Citation">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The link from an assistant turn to one assertion that the answer used. The ER relationship Cites becomes this class, because the relationship has the attribute Rank.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Citation</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b47"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b48"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b49"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b50"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ClinicalEntry">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">One clinical fact of a visit, for example a diagnosis or a prescription. Each entry is exactly one of the 8 subclasses. The assertions about the entry give its history.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Clinical entry</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b51"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b52"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b53"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b54"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b55"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b56"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b57"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b58"/>
  <disjointUnionOf xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b59"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b60"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Department">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A unit of the hospital, for example a clinic or a ward.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Department</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b61"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b62"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b63"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b64"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/Organization"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Diagnosis">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A clinical entry that names a condition of the patient.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Diagnosis</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ClinicalEntry"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b65"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/Condition"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Doctor">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A staff member who is a physician.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Doctor</label>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Staff"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#LabOrder">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A clinical entry that orders a laboratory test.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
