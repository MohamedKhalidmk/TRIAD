  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  <minCardinality xmlns="http://www.w3.org/2002/07/owl#" rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</minCardinality>
  <onProperty xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#identifierSystem"/>
</rdf:Description>
<rdf:Description rdf:nodeID="b102">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
