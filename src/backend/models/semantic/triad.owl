  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b98"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/MedicationRequest"/>
