  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The name of the patient of the log record, as a value. Columns: ChatSession.SubjectName, AuditEvent.SubjectName.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b157"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">subject name</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
