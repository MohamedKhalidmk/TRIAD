  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A clinical entry that records a procedure on the patient.</comment>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Procedure</label>
