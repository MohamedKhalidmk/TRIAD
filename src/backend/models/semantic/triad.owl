  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A person who gets care in the hospital. The name and the date of birth identify the patient.</comment>
