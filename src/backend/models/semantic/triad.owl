</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#verification">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The verification status of the claim. A closed value set. Column: Assertion.Verification.</comment>
