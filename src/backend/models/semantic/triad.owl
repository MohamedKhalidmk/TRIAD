  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b109"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b110"/>
  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b111"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b112"/>
