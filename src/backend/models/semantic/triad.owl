  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">visit class</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b161"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#visitOf">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The patient of the visit. This is the inverse of hasVisit. The store has no triples of it. The chain of ofPatient uses it.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Visit"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">visit of</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Patient"/>
  <inverseOf xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#hasVisit"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#visitType">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
