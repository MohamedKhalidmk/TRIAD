  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#PatientIdentifier"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#identifierSystem">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The system of the identifier: a URI that names the namespace of the value. With identifierValue it identifies the individual. Columns: IdentifierSystem of Department, Location, Staff, Visit, ClinicalEntry, Message, ChatSession and AuditEvent; PatientIdentifier.System.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b135"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">identifier system</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#identifierValue">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The value of the identifier in its system. Columns: IdentifierValue of Department, Location, Staff, Visit, ClinicalEntry, Message, ChatSession and AuditEvent; PatientIdentifier.Value.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b136"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">identifier value</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#inMessage">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The message that contains the assertion. This is the inverse of contains. The store has no triples of it. The key of Assertion and the chain of assertedBy use it.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">in message</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
  <inverseOf xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#contains"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#inSession">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The chat session that includes the turn. This is the inverse of includes. The store has no triples of it. The keys of ChatTurn use it.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatTurn"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">in session</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatSession"/>
  <inverseOf xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#includes"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#inTurn">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The chat turn that caused the audit record. An audit record has zero or one turn. Column: AuditEvent.ChatTurnId.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#AuditEvent"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">in turn</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatTurn"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#includes">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The chat session includes the turn. This is the identifying relationship of the weak entity ChatTurn. Column: ChatTurn.ChatSessionId.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatSession"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">includes</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#ChatTurn"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#intent">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The intent of the claim: a report, a recommendation or a decision. A closed value set. Column: Assertion.Intent.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">intent</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b137"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#issuedBy">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The staff member who issued the message. This is the inverse of issues. The store has no triples of it.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">issued by</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Staff"/>
  <subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
  <inverseOf xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#issues"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#issuedDate">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The time when the laboratory issued the report. Column: LabReport.IssuedDate.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#LabReport"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">issued date</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#issues">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The staff member issues the message. A message has zero or one issuer. A message with no issuer comes from the patient. Column: Message.StaffId.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Staff"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">issues</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#language">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A language that the staff member speaks, as a BCP 47 code. A staff member can have many languages: each one is a triple. Column: StaffLanguage.Language.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Staff"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">language</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#licenseNumber">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The professional license number. Columns: Doctor.LicenseNumber, Nurse.LicenseNumber.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b138"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">license number</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#locationType">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The type of the location, for example a ward or an emergency room. Column: Location.Type.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Location"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">location type</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#manufacturer">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The manufacturer of the medication. Column: Medication.Manufacturer.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Medication"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">manufacturer</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#member">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">One member of the care team. Each member belongs to exactly one care team. Column: CareTeamMember.CareTeamId (through CareTeam.ClinicalEntryId).</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeam"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeamMember"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#memberOf">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The care team of the member. This is the inverse of member. The store has no triples of it. The key of CareTeamMember uses it.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeamMember"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member of</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeam"/>
  <inverseOf xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#member"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#memberRole">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The role of the member in the care team. Column: CareTeamMember.Role.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeamMember"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member role</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#memberSystem">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The identifier system of the staff member of the care team, as a value. Column: CareTeamMember.MemberSystem.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#CareTeamMember"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member system</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#memberValue">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The identifier value of the staff member of the care team, as a value. A guard checks that exactly one staff member has this identifier. Column: CareTeamMember.MemberValue.</comment>
