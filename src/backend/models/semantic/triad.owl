  <subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="b91"/>
  <hasKey xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="b92"/>
  <closeMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://hl7.org/fhir/Patient"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#PatientIdentifier">
