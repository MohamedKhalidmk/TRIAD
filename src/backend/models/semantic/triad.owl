  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The action of the access. A closed value set. Column: AuditEvent.Action.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#AuditEvent"/>
