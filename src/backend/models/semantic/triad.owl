</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#visitClass">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The class of the visit (FHIR Encounter.class): ambulatory, emergency, inpatient, home health or virtual. A closed value set. Column: Visit.Class.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Visit"/>
