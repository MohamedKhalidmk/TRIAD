<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad">
  <creator xmlns="http://purl.org/dc/terms/">Asish A. George</creator>
  <creator xmlns="http://purl.org/dc/terms/">Mohamed Khaled</creator>
  <license xmlns="http://purl.org/dc/terms/" rdf:resource="https://creativecommons.org/licenses/by-nc-sa/4.0/"/>
  <source xmlns="http://purl.org/dc/terms/" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/blob/main/src/backend/models/er/README.md"/>
  <source xmlns="http://purl.org/dc/terms/" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/blob/main/src/backend/models/relational/sql/ddl/01_create_tables.sql"/>
  <title xmlns="http://purl.org/dc/terms/" xml:lang="en">TRIAD: Trusted RDF Interoperable Agent Data</title>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The ontology of TRIAD, a model for clinical records that many people make and change over time. Each clinical fact is an assertion with an author and a source message. A new assertion supersedes the old one. The ontology maps the TRIAD ER model and its 29 relations to RDFS and OWL 2 DL. The data is in a separate named graph. All data is synthetic.</comment>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">TRIAD ontology</label>
  <versionIRI xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad/5.0.0"/>
  <versionInfo xmlns="http://www.w3.org/2002/07/owl#">5.0.0</versionInfo>
</rdf:Description>
<rdf:Description rdf:nodeID="b1">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  <minCardinality xmlns="http://www.w3.org/2002/07/owl#" rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</minCardinality>
  <onProperty xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#substance"/>
</rdf:Description>
<rdf:Description rdf:nodeID="b10">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  <onClass xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Message"/>
  <onProperty xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#inMessage"/>
  <qualifiedCardinality xmlns="http://www.w3.org/2002/07/owl#" rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</qualifiedCardinality>
</rdf:Description>
<rdf:Description rdf:nodeID="b100">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  <minCardinality xmlns="http://www.w3.org/2002/07/owl#" rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</minCardinality>
  <onProperty xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#identifierValue"/>
</rdf:Description>
