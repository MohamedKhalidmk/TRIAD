<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#supersedes">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The new assertion replaces the old assertion. An assertion replaces zero or one assertion, and zero or one assertion replaces it. Column: Assertion.SupersedesId.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">supersedes</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion"/>
  <subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
  <subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#supersedesTransitively"/>
</rdf:Description>
<rdf:Description rdf:about="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#supersedesTransitively">
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <type xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The assertion replaces the other assertion directly or through a chain of supersedes links. It is transitive, and supersedes is a sub-property of it.</comment>
  <domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion"/>
  <isDefinedBy xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad"/>
  <label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">supersedes transitively</label>
  <range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#Assertion"/>
</rdf:Description>
