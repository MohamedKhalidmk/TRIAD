    rr:predicateObjectMap [ rr:predicate triad:unit ; rr:objectMap [ rr:column "Unit" ] ] .

# --------------------------------------------------------------------------------------------------------------
# LabOrder: kg:clinical-entry/{ClinicalEntryId} (the individual of its ClinicalEntry row), also a triad:LabOrder
