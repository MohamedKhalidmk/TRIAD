    rr:predicateObjectMap [ rr:predicate triad:specimen ; rr:objectMap [ rr:column "Specimen" ] ] .

# --------------------------------------------------------------------------------------------------------------
# LabReport: kg:clinical-entry/{ClinicalEntryId} (the individual of its ClinicalEntry row), also a triad:LabReport
# --------------------------------------------------------------------------------------------------------------
map:LabReport a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "LabReport" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/clinical-entry/{ClinicalEntryId}" ;
