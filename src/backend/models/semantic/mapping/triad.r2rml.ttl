# PatientIdentifier.PatientId, the reverse direction:
#     kg:patient/{PatientId} triad:identifier kg:patient-identifier/{Id}
map:PatientIdentifier_PatientId a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "PatientIdentifier" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/patient/{PatientId}" ] ;
