    rr:predicateObjectMap [ rr:predicate triad:procedureOutcome ; rr:objectMap [ rr:column "Outcome" ] ] .

# --------------------------------------------------------------------------------------------------------------
# Allergy: kg:clinical-entry/{ClinicalEntryId} (the individual of its ClinicalEntry row), also a triad:Allergy
# --------------------------------------------------------------------------------------------------------------
map:Allergy a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Allergy" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/clinical-entry/{ClinicalEntryId}" ;
                    rr:class triad:Allergy ] ;
