# --------------------------------------------------------------------------------------------------------------
map:PatientIdentifier a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "PatientIdentifier" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/patient-identifier/{Id}" ;
