    rr:predicateObjectMap [ rr:predicate triad:region ; rr:objectMap [ rr:column "Region" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:postalCode ; rr:objectMap [ rr:column "PostalCode" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:country ; rr:objectMap [ rr:column "Country" ] ] .

# --------------------------------------------------------------------------------------------------------------
