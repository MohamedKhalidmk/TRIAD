    rr:predicateObjectMap [ rr:predicate triad:patientSex ; rr:objectMap [ rr:column "Sex" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:phoneNumber ; rr:objectMap [ rr:column "PhoneNumber" ] ] ;
