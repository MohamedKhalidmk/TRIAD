map:Visit a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Visit" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/visit/{Id}" ; rr:class triad:Visit ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierSystem ; rr:objectMap [ rr:column "IdentifierSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierValue ; rr:objectMap [ rr:column "IdentifierValue" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:visitClass ; rr:objectMap [ rr:column "Class" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:visitType ; rr:objectMap [ rr:column "Type" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:reason ; rr:objectMap [ rr:column "Reason" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:startDate ;
        rr:objectMap [ rr:column "StartDate" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:endDate ;
        rr:objectMap [ rr:column "EndDate" ; rr:datatype xsd:dateTime ] ] .

# Visit.PatientId, the reverse direction:
#     kg:patient/{PatientId} triad:hasVisit kg:visit/{Id}
map:Visit_PatientId a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Visit" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/patient/{PatientId}" ] ;
    rr:predicateObjectMap [ rr:predicate triad:hasVisit ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/visit/{Id}" ] ] .

