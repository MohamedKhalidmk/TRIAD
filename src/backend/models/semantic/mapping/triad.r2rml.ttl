    rr:predicateObjectMap [ rr:predicate triad:allergyCategory ; rr:objectMap [ rr:column "AllergyCategory" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:criticality ; rr:objectMap [ rr:column "Criticality" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:clinicalStatus ; rr:objectMap [ rr:column "ClinicalStatus" ] ] .

