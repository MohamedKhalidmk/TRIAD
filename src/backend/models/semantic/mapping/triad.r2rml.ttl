# TRIAD: the W3C R2RML mapping (https://www.w3.org/TR/r2rml/) from the SQLite database to RDF.
# Milestone 5, plan section 3.1. Morph-KGC 2.10.0 runs it (infrastructure/rdf/kg_export.py,
# main.py export-kg).
#
# Do not edit this file by hand. build_mapping.py writes it from vocabulary.py and 01_create_tables.sql:
#     .venv/bin/python src/backend/models/semantic/mapping/build_mapping.py
# The terms are the terms of ../triad.ttl. The subject IRIs are the ones of ../ontology.md section 1.
#
# 35 TriplesMaps: 29 for the tables (in the order of the DDL), 6 for the foreign keys in the reverse direction.
#
# The rules (each rule comes from a failed test):
# - Each TriplesMap reads a table (rr:tableName) and its columns (rr:column). Morph-KGC adds "IS NOT NULL"
#   for each column, so a NULL gives no triple. The mapping has no rr:sqlQuery: in a query, Morph-KGC turns a
#   NULL into the literal "None", and a nullable integer foreign key into an IRI that ends in ".0".
# - The configuration of Morph-KGC sets na_values to a value that is not in the data. The default (",nan")
#   drops the real values "" and "nan", which R2RML does not allow.
# - A subtype row (Doctor, Nurse, MOA and the 8 entry subtypes) is the same individual as its parent row.
#   Its TriplesMap uses the parent Id (StaffId, ClinicalEntryId) and adds the second rr:class.
# - A foreign key in the stored direction (about, during, prescribes, ...) is an object map with the
#   template of the target IRI. A foreign key in the reverse direction (hasVisit, contains, issues, includes,
#   identifier, member) has a TriplesMap of its own: the subject is the target, and the object is the row.
# - CareTeamMember.CareTeamId holds CareTeam.Id, not the entry Id, so its TriplesMap joins CareTeam
#   (rr:parentTriplesMap and rr:joinCondition).
# - Dates are xsd:date. Times are xsd:dateTime with the exact text of the database. Seq and Rank are
#   xsd:integer, and Active is xsd:boolean ("1" and "0" are valid forms). Text values are simple
#   literals (no rr:datatype xsd:string).

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix triad: <https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#> .
@prefix map: <https://github.com/MohamedKhalidmk/TRIAD/mapping/triad#> .

# --------------------------------------------------------------------------------------------------------------
# Department: kg:department/{Id}, a triad:Department
# --------------------------------------------------------------------------------------------------------------
map:Department a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Department" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/department/{Id}" ;
                    rr:class triad:Department ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierSystem ; rr:objectMap [ rr:column "IdentifierSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierValue ; rr:objectMap [ rr:column "IdentifierValue" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:name ; rr:objectMap [ rr:column "Name" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:departmentType ; rr:objectMap [ rr:column "Type" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:phoneNumber ; rr:objectMap [ rr:column "PhoneNumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:email ; rr:objectMap [ rr:column "Email" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:street ; rr:objectMap [ rr:column "Street" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:city ; rr:objectMap [ rr:column "City" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:region ; rr:objectMap [ rr:column "Region" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:postalCode ; rr:objectMap [ rr:column "PostalCode" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:country ; rr:objectMap [ rr:column "Country" ] ] .

# --------------------------------------------------------------------------------------------------------------
# Location: kg:location/{Id}, a triad:Location
# --------------------------------------------------------------------------------------------------------------
map:Location a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Location" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/location/{Id}" ;
                    rr:class triad:Location ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierSystem ; rr:objectMap [ rr:column "IdentifierSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierValue ; rr:objectMap [ rr:column "IdentifierValue" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:name ; rr:objectMap [ rr:column "Name" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:locationType ; rr:objectMap [ rr:column "Type" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:physicalType ; rr:objectMap [ rr:column "PhysicalType" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:phoneNumber ; rr:objectMap [ rr:column "PhoneNumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:street ; rr:objectMap [ rr:column "Street" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:city ; rr:objectMap [ rr:column "City" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:region ; rr:objectMap [ rr:column "Region" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:postalCode ; rr:objectMap [ rr:column "PostalCode" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:country ; rr:objectMap [ rr:column "Country" ] ] .

# --------------------------------------------------------------------------------------------------------------
# Staff: kg:staff/{Id}, a triad:Staff
# --------------------------------------------------------------------------------------------------------------
map:Staff a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Staff" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/staff/{Id}" ; rr:class triad:Staff ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierSystem ; rr:objectMap [ rr:column "IdentifierSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierValue ; rr:objectMap [ rr:column "IdentifierValue" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:name ; rr:objectMap [ rr:column "Name" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:staffSex ; rr:objectMap [ rr:column "Sex" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:email ; rr:objectMap [ rr:column "Email" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:phoneNumber ; rr:objectMap [ rr:column "PhoneNumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:active ;
        rr:objectMap [ rr:column "Active" ; rr:datatype xsd:boolean ] ] .

# --------------------------------------------------------------------------------------------------------------
# StaffLanguage: kg:staff/{StaffId} (no individual of its own: each row is one triple of that staff member)
# --------------------------------------------------------------------------------------------------------------
map:StaffLanguage a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "StaffLanguage" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/staff/{StaffId}" ] ;
    rr:predicateObjectMap [ rr:predicate triad:language ; rr:objectMap [ rr:column "Language" ] ] .

# --------------------------------------------------------------------------------------------------------------
# WorksIn: kg:works-in/{Id}, a triad:WorksIn
# --------------------------------------------------------------------------------------------------------------
map:WorksIn a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "WorksIn" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/works-in/{Id}" ;
                    rr:class triad:WorksIn ] ;
    rr:predicateObjectMap [ rr:predicate triad:ofStaff ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/staff/{StaffId}" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:atDepartment ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/department/{DepartmentId}" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:roleCode ; rr:objectMap [ rr:column "RoleCode" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:specialty ; rr:objectMap [ rr:column "Specialty" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:roleStartDate ;
        rr:objectMap [ rr:column "StartDate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:roleEndDate ;
        rr:objectMap [ rr:column "EndDate" ; rr:datatype xsd:date ] ] .

# --------------------------------------------------------------------------------------------------------------
# Doctor: kg:staff/{StaffId} (the individual of its Staff row), also a triad:Doctor
# --------------------------------------------------------------------------------------------------------------
map:Doctor a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Doctor" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/staff/{StaffId}" ;
                    rr:class triad:Doctor ] ;
    rr:predicateObjectMap [ rr:predicate triad:licenseNumber ; rr:objectMap [ rr:column "LicenseNumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:qualification ; rr:objectMap [ rr:column "Qualification" ] ] .

