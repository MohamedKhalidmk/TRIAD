                    rr:class triad:ClinicalEntry ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierSystem ; rr:objectMap [ rr:column "IdentifierSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierValue ; rr:objectMap [ rr:column "IdentifierValue" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:during ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/visit/{VisitId}" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:code ; rr:objectMap [ rr:column "Code" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:codeSystem ; rr:objectMap [ rr:column "CodeSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:display ; rr:objectMap [ rr:column "Display" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:text ; rr:objectMap [ rr:column "Text" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:recordedAt ;
        rr:objectMap [ rr:column "RecordedAt" ; rr:datatype xsd:dateTime ] ] .

