# CareTeamMember.CareTeamId, the reverse direction, with a join of CareTeam:
#     kg:clinical-entry/{CareTeam.ClinicalEntryId} triad:member kg:care-team-member/{Id}
# CareTeamMember.CareTeamId holds CareTeam.Id, but the IRI of the CareTeam individual uses CareTeam.ClinicalEntryId.
# So this TriplesMap reads CareTeam and joins the CareTeamMember rows. A plain template would put
# each member on the wrong entry.
map:CareTeamMember_CareTeamId a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "CareTeam" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/clinical-entry/{ClinicalEntryId}" ] ;
    rr:predicateObjectMap [ rr:predicate triad:member ;
        rr:objectMap [ rr:parentTriplesMap map:CareTeamMember ;
                       rr:joinCondition [ rr:child "Id" ; rr:parent "CareTeamId" ] ] ] .

# --------------------------------------------------------------------------------------------------------------
# Message: kg:message/{Id}, a triad:Message
# --------------------------------------------------------------------------------------------------------------
map:Message a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Message" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/message/{Id}" ;
                    rr:class triad:Message ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierSystem ; rr:objectMap [ rr:column "IdentifierSystem" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:identifierValue ; rr:objectMap [ rr:column "IdentifierValue" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:channel ; rr:objectMap [ rr:column "Channel" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:origin ; rr:objectMap [ rr:column "Origin" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:sentAt ;
        rr:objectMap [ rr:column "SentAt" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:text ; rr:objectMap [ rr:column "Text" ] ] .

# Message.StaffId, the reverse direction:
#     kg:staff/{StaffId} triad:issues kg:message/{Id}
map:Message_StaffId a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Message" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/staff/{StaffId}" ] ;
    rr:predicateObjectMap [ rr:predicate triad:issues ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/message/{Id}" ] ] .

# --------------------------------------------------------------------------------------------------------------
# Assertion: kg:assertion/{Id}, a triad:Assertion
# --------------------------------------------------------------------------------------------------------------
map:Assertion a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Assertion" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/assertion/{Id}" ;
                    rr:class triad:Assertion ] ;
    rr:predicateObjectMap [ rr:predicate triad:seq ; rr:objectMap [ rr:column "Seq" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:about ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/clinical-entry/{ClinicalEntryId}" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:supersedes ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/assertion/{SupersedesId}" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:assertedAt ;
        rr:objectMap [ rr:column "AssertedAt" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:intent ; rr:objectMap [ rr:column "Intent" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:source ; rr:objectMap [ rr:column "Source" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:verification ; rr:objectMap [ rr:column "Verification" ] ] ;
    rr:predicateObjectMap [ rr:predicate triad:statement ; rr:objectMap [ rr:column "Statement" ] ] .

# Assertion.MessageId, the reverse direction:
#     kg:message/{MessageId} triad:contains kg:assertion/{Id}
map:Assertion_MessageId a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Assertion" ] ;
    rr:subjectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/message/{MessageId}" ] ;
    rr:predicateObjectMap [ rr:predicate triad:contains ;
        rr:objectMap [ rr:template "https://github.com/MohamedKhalidmk/TRIAD/kg/assertion/{Id}" ] ] .

