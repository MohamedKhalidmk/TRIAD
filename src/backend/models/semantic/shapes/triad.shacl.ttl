# SQL: CONSTRAINT UK_Medication_Code_CodeSystem UNIQUE (Code, CodeSystem)
# triad.ttl: triad:Medication owl:hasKey ( triad:code triad:codeSystem ).
shape:UK_Medication_Code_CodeSystem a sh:SPARQLConstraint ;
    sh:message "Another triad:Medication ({?value}) has the same values of triad:code and triad:codeSystem. The key must be unique (UK_Medication_Code_CodeSystem)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:code ?key1 ;
                triad:codeSystem ?key2 .
            ?value triad:code ?key1 ;
                triad:codeSystem ?key2 ;
                a triad:Medication .
            FILTER (?value != $this)
        }
        """ .

