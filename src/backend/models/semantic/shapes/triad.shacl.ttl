# ==============================================================================================================
# Part 2: the hand-written rules. build_shapes.py does not change this part.
# ==============================================================================================================
# Each rule below is a shape or a constraint. The lines "shape:<Class>Shape sh:property ..." and
# "shape:<Class>Shape sh:sparql ..." add it to the node shape of its class in part 1.
# The SPARQL constraints select $this (the focus node) and ?value (a node that shows the problem).
# The patient of an assertion is the path triad:about/triad:during/^triad:hasVisit (triad:ofPatient in triad.ttl).

# --------------------------------------------------------------------------------------------------------------
# The date pairs: CHECK (EndDate >= StartDate)
# --------------------------------------------------------------------------------------------------------------
# sh:lessThanOrEquals compares two values with the SPARQL operator <=. Two xsd:dateTime values with a time zone
# offset compare as instants: "2026-10-03T01:10:00+05:30" is earlier than "2026-10-02T16:05:30-04:00".
# SQLite julianday() also compares instants. A missing end date gives no comparison (the SQL allows NULL).

# SQL: Visit: CHECK (EndDate IS NULL OR julianday(EndDate) >= julianday(StartDate))
shape:Visit-dates a sh:PropertyShape ;
    sh:path triad:startDate ;
    sh:lessThanOrEquals triad:endDate ;
    sh:message "A triad:Visit must not end before it starts: triad:endDate must be the same as or later than triad:startDate (Visit.EndDate)." .

# SQL: VisitLocation: CHECK (EndDate IS NULL OR julianday(EndDate) >= julianday(StartDate))
shape:VisitLocation-dates a sh:PropertyShape ;
    sh:path triad:startDate ;
    sh:lessThanOrEquals triad:endDate ;
    sh:message "A triad:VisitLocation must not end before it starts: triad:endDate must be the same as or later than triad:startDate (VisitLocation.EndDate)." .

# SQL: WorksIn: CHECK (EndDate IS NULL OR StartDate IS NULL OR julianday(EndDate) >= julianday(StartDate))
shape:WorksIn-dates a sh:PropertyShape ;
    sh:path triad:roleStartDate ;
    sh:lessThanOrEquals triad:roleEndDate ;
    sh:message "A triad:WorksIn role must not end before it starts: triad:roleEndDate must be the same as or later than triad:roleStartDate (WorksIn.EndDate)." .

shape:VisitShape sh:property shape:Visit-dates .
shape:VisitLocationShape sh:property shape:VisitLocation-dates .
shape:WorksInShape sh:property shape:WorksIn-dates .

# --------------------------------------------------------------------------------------------------------------
# The issuer of a message: CHECK (StaffId IS NOT NULL OR Origin = 'Patient')
# --------------------------------------------------------------------------------------------------------------
# This rule is a node shape of its own. pyshacl adds the sh:message of a node shape to each result of that shape,
# also to the results of its SPARQL constraints. So shape:MessageShape has no sh:message.

# SQL: Message: CHECK (StaffId IS NOT NULL OR Origin = 'Patient')
shape:MessageIssuerShape a sh:NodeShape ;
    sh:targetClass triad:Message ;
    sh:or (
        [ sh:path [ sh:inversePath triad:issues ] ; sh:minCount 1 ]
        [ sh:path triad:origin ; sh:hasValue "Patient" ]
    ) ;
    sh:message "A triad:Message with no issuer must come from the patient: a triad:Staff must issue it (triad:issues), or its triad:origin must be Patient (Message.StaffId, Message.Origin)." .

# --------------------------------------------------------------------------------------------------------------
# The staff member of a language
# --------------------------------------------------------------------------------------------------------------
# A StaffLanguage row is one triad:language triple of its staff member. So its foreign key is a rule on the
# subject of the triple. (The other foreign keys are rules on the values: sh:class in part 1.)

# SQL: CONSTRAINT FK_StaffLanguage_StaffId_2_Staff_Id FOREIGN KEY (StaffId) REFERENCES Staff (Id)
shape:language-subject a sh:PropertyShape ;
    sh:targetSubjectsOf triad:language ;
    sh:path rdf:type ;
    sh:hasValue triad:Staff ;
    sh:message "Only a triad:Staff can have a value of triad:language (StaffLanguage.StaffId)." .

# --------------------------------------------------------------------------------------------------------------
# Supersedes: the CHECK and the trigger TR_Assertion_Supersede_Check
# --------------------------------------------------------------------------------------------------------------

shape:AssertionShape sh:sparql
    shape:Assertion-supersedes-not-reflexive ,
    shape:Assertion-supersedes-no-cycle ,
    shape:Assertion-supersedes-not-newer ,
    shape:Assertion-supersedes-same-patient .

# SQL: Assertion: CHECK (SupersedesId IS NULL OR SupersedesId <> Id)
# triad.ttl: triad:supersedes is Irreflexive and Asymmetric. A reasoner finds this error; this check finds it
# without a reasoner.
shape:Assertion-supersedes-not-reflexive a sh:SPARQLConstraint ;
    sh:message "The assertion supersedes itself. An assertion can supersede only another assertion (CHECK SupersedesId <> Id)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this
        WHERE {
            $this triad:supersedes $this .
        }
        """ .

# SQL: no constraint. In SQLite a cycle cannot occur: a new row can point only to an old row (FOREIGN KEY), and
# the rows do not change (TR_Assertion_NoUpdate). A graph has no such order, so this rule is new (plan 1.7).
# OWL 2 DL cannot hold it: it does not allow Irreflexive on the transitive triad:supersedesTransitively.
shape:Assertion-supersedes-no-cycle a sh:SPARQLConstraint ;
    sh:message "The assertion is in a cycle of triad:supersedes links ({?value} is in the same cycle). A chain of revisions must have an end (new in Milestone 5)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:supersedes ?value .
            ?value triad:supersedes+ $this .
            FILTER (?value != $this)
        }
        """ .

# SQL: TR_Assertion_Supersede_Check, 'The superseded assertion is newer than the new assertion.'
# The SPARQL operator > compares two xsd:dateTime values as instants, as julianday() does in SQLite.
shape:Assertion-supersedes-not-newer a sh:SPARQLConstraint ;
    sh:message "The superseded assertion {?value} is newer than this assertion. An assertion can supersede only an assertion that is not newer (TR_Assertion_Supersede_Check)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:supersedes ?value ;
                triad:assertedAt ?newAt .
            ?value triad:assertedAt ?oldAt .
            FILTER (?oldAt > ?newAt)
        }
        """ .

# SQL: TR_Assertion_Supersede_Check, 'The superseded assertion is about another patient.'
shape:Assertion-supersedes-same-patient a sh:SPARQLConstraint ;
    sh:message "The superseded assertion {?value} is about another patient. An assertion can supersede only an assertion about the same patient (TR_Assertion_Supersede_Check)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:supersedes ?value ;
                triad:about/triad:during/^triad:hasVisit ?patient .
            ?value triad:about/triad:during/^triad:hasVisit ?oldPatient .
            FILTER (?oldPatient != ?patient)
        }
        """ .

# --------------------------------------------------------------------------------------------------------------
# The other triggers of Assertion
# --------------------------------------------------------------------------------------------------------------

shape:ClinicalEntryShape sh:sparql shape:ClinicalEntry-one-head .
shape:MessageShape sh:sparql shape:Message-one-patient .

# SQL: TR_Assertion_One_Head_Per_Entry, 'The entry has a current assertion. The new assertion must supersede it.'
# The current assertion (the head) of an entry is an assertion about the entry that no assertion supersedes.
# "No triple" means "false" here: this is a closed-world rule (ontology.md section 8).
shape:ClinicalEntry-one-head a sh:SPARQLConstraint ;
    sh:message "The entry has more than one current assertion ({?value} and {?other}). A new assertion about an entry must supersede its current assertion (TR_Assertion_One_Head_Per_Entry)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value ?other
        WHERE {
            ?value triad:about $this .
            ?other triad:about $this .
            FILTER (STR(?value) < STR(?other))
            FILTER NOT EXISTS { ?newer triad:supersedes ?value }
            FILTER NOT EXISTS { ?newer triad:supersedes ?other }
        }
        """ .

# SQL: TR_Assertion_One_Patient_Per_Message, 'All assertions of a message must be about one patient.'
shape:Message-one-patient a sh:SPARQLConstraint ;
    sh:message "The assertions of this message are about more than one patient ({?value} and {?other}). All assertions of a message must be about one patient (TR_Assertion_One_Patient_Per_Message)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value ?other
        WHERE {
            $this triad:contains ?value , ?other .
            ?value triad:about/triad:during/^triad:hasVisit ?patient .
            ?other triad:about/triad:during/^triad:hasVisit ?otherPatient .
            FILTER (?otherPatient != ?patient && STR(?value) < STR(?other))
        }
        """ .

# --------------------------------------------------------------------------------------------------------------
# The care team, the agent layer and the audit log
# --------------------------------------------------------------------------------------------------------------

shape:CareTeamMemberShape sh:sparql shape:CareTeamMember-staff .
shape:CitationShape sh:sparql shape:Citation-assistant-turn , shape:Citation-patient .
shape:AuditEventShape sh:sparql shape:AuditEvent-subject .

# SQL: TR_CareTeamMember_Staff_Check, 'The care-team member is not a staff member.'
# A member keeps the identifier of a staff member as values (a FHIR reference by identifier), not as a link.
shape:CareTeamMember-staff a sh:SPARQLConstraint ;
    sh:message "The care-team member is not a staff member: no triad:Staff has its triad:memberSystem and triad:memberValue as identifier (TR_CareTeamMember_Staff_Check)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this
        WHERE {
            $this triad:memberSystem ?system ;
                triad:memberValue ?identifier .
            FILTER NOT EXISTS {
                ?staff triad:identifierSystem ?system ;
                    triad:identifierValue ?identifier ;
                    a triad:Staff .
            }
        }
        """ .

# SQL: TR_Citation_Check, 'Only an assistant turn can cite an assertion.'
shape:Citation-assistant-turn a sh:SPARQLConstraint ;
    sh:message "The citation comes from the turn {?value}, which is not an assistant turn. Only an assistant turn can cite an assertion (TR_Citation_Check)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:byTurn ?value .
            ?value triad:speaker ?speaker .
            FILTER (?speaker != "Assistant")
        }
        """ .

# SQL: TR_Citation_Check, 'The cited assertion is not about the patient of the chat session.'
# The session keeps its patient as values (triad:subjectName, triad:subjectDateOfBirth): the key of the patient.
shape:Citation-patient a sh:SPARQLConstraint ;
    sh:message "The cited assertion {?value} is not about the patient of the chat session. A turn can cite only an assertion about the patient of its session (TR_Citation_Check)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:byTurn ?turn ;
                triad:citedAssertion ?value .
            FILTER NOT EXISTS {
                ?session triad:includes ?turn ;
                    triad:subjectName ?name ;
                    triad:subjectDateOfBirth ?dateOfBirth .
                ?value triad:about/triad:during/^triad:hasVisit ?patient .
                ?patient triad:name ?name ;
                    triad:dateOfBirth ?dateOfBirth .
            }
        }
        """ .

# SQL: TR_AuditEvent_Subject_Check, 'The audit subject is not the patient of the chat session.'
shape:AuditEvent-subject a sh:SPARQLConstraint ;
    sh:message "The audit subject is not the patient of the chat session of the turn {?value}. An audit record of a chat turn must have the patient of that session as its subject (TR_AuditEvent_Subject_Check)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:inTurn ?value ;
                triad:subjectName ?name ;
                triad:subjectDateOfBirth ?dateOfBirth .
            FILTER NOT EXISTS {
                ?session triad:includes ?value ;
                    triad:subjectName ?name ;
                    triad:subjectDateOfBirth ?dateOfBirth .
            }
        }
        """ .

# --------------------------------------------------------------------------------------------------------------
# The SQL rules that have no shape
# --------------------------------------------------------------------------------------------------------------
# - TR_Assertion_NoUpdate, TR_Assertion_NoDelete, TR_AuditEvent_NoUpdate, TR_AuditEvent_NoDelete (append-only) and
#   TR_Patient_Key_NoUpdate: a graph has no "update" event. The SPARQL delete helper and the use cases hold them
#   (plan 1.7 and 5.4).
# - UK_StaffLanguage_StaffId_Language: a graph holds each triple once, so a language cannot repeat.
# - UK_Staff_Id_Role, UK_ClinicalEntry_Id_Category: the targets of the composite foreign keys of the subtypes. The
#   Id is in the IRI, and the subtype is a type of the same individual (the rules shape:<Subtype>-type).
