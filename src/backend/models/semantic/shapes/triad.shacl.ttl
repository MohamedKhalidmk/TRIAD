# SQL: ClinicalEntry.Category TEXT NOT NULL CHECK (Category IN ('Diagnosis', 'Procedure', 'Allergy', 'Observation', 'LabOrder', 'LabReport', 'Prescription', 'CareTeam'))
# SQL: the subtype rows (UK_Diagnosis_ClinicalEntryId, UK_Procedure_ClinicalEntryId, UK_Allergy_ClinicalEntryId, UK_Observation_ClinicalEntryId, UK_LabOrder_ClinicalEntryId, UK_LabReport_ClinicalEntryId, UK_Prescription_ClinicalEntryId, UK_CareTeam_ClinicalEntryId).
# The discriminator gives no property: rdf:type holds it (ontology.md section 2).
shape:ClinicalEntry-subtype a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:qualifiedValueShape [ sh:in ( triad:Diagnosis triad:Procedure triad:Allergy triad:Observation triad:LabOrder triad:LabReport triad:Prescription triad:CareTeam ) ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
    sh:message "Each triad:ClinicalEntry must have exactly one subtype: triad:Diagnosis, triad:Procedure, triad:Allergy, triad:Observation, triad:LabOrder, triad:LabReport, triad:Prescription or triad:CareTeam (ClinicalEntry.Category; the ISA is disjoint and total)." .

