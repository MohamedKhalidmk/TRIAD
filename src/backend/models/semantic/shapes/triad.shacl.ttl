    sh:property
        shape:Location-identifierSystem ,
        shape:Location-identifierValue ,
        shape:Location-name ,
        shape:Location-locationType ,
        shape:Location-physicalType ,
        shape:Location-phoneNumber ,
        shape:Location-street ,
        shape:Location-city ,
        shape:Location-region ,
        shape:Location-postalCode ,
        shape:Location-country ;
    sh:sparql shape:UK_Location_Identifier .

# SQL: Location.IdentifierSystem TEXT NOT NULL
shape:Location-identifierSystem a sh:PropertyShape ;
    sh:path triad:identifierSystem ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
