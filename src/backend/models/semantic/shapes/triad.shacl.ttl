# TRIAD: the W3C SHACL shapes (https://www.w3.org/TR/shacl/) of the knowledge graph. Milestone 5, plan 3.4.
#
# The shapes hold the closed-world rules of the SQLite schema (01_create_tables.sql): NOT NULL, CHECK ... IN,
# the foreign keys, the UNIQUE constraints, the CHECKs across columns and the triggers. OWL cannot hold them,
# because OWL uses the Open World Assumption (ontology.md section 8).
#
# This file has two parts:
# 1. The generated part (to the END line). Do not edit it by hand. build_shapes.py writes it from ../triad.ttl,
#    ../vocabulary.py and 01_create_tables.sql:
#        .venv/bin/python src/backend/models/semantic/shapes/build_shapes.py
# 2. The hand-written part (after the END line): the rules across columns and the rules of the triggers.
#
# Each shape and constraint has an sh:message that names the rule. The comment above it names the SQL that
# it replaces. Run the shapes with: python -m infrastructure.rdf.shacl FILE (PYTHONPATH=src/backend).

@prefix shape: <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad#> .
@prefix triad: <https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# The shapes graph. Its sh:declare values give the prefixes of the SPARQL constraints (sh:prefixes).
<https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> a owl:Ontology ;
    rdfs:label "TRIAD SHACL shapes"@en ;
    rdfs:comment "The closed-world rules of the TRIAD knowledge graph: the rules of the SQLite schema that OWL cannot hold."@en ;
    sh:declare
        [ sh:prefix "triad" ; sh:namespace "https://github.com/MohamedKhalidmk/TRIAD/ontology/triad#"^^xsd:anyURI ] ,
        [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

# --------------------------------------------------------------------------------------------------------------
# triad:Department (the rows of the table Department)
# --------------------------------------------------------------------------------------------------------------

shape:DepartmentShape a sh:NodeShape ;
    sh:targetClass triad:Department ;
    sh:property
        shape:Department-identifierSystem ,
        shape:Department-identifierValue ,
        shape:Department-name ,
        shape:Department-departmentType ,
        shape:Department-phoneNumber ,
        shape:Department-email ,
        shape:Department-street ,
        shape:Department-city ,
        shape:Department-region ,
        shape:Department-postalCode ,
        shape:Department-country ;
    sh:sparql shape:UK_Department_Identifier .

# SQL: Department.IdentifierSystem TEXT NOT NULL
shape:Department-identifierSystem a sh:PropertyShape ;
    sh:path triad:identifierSystem ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department must have exactly one value of triad:identifierSystem. The value must be an xsd:string (Department.IdentifierSystem)." .

# SQL: Department.IdentifierValue TEXT NOT NULL
shape:Department-identifierValue a sh:PropertyShape ;
    sh:path triad:identifierValue ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department must have exactly one value of triad:identifierValue. The value must be an xsd:string (Department.IdentifierValue)." .

# SQL: Department.Name TEXT NOT NULL
shape:Department-name a sh:PropertyShape ;
    sh:path triad:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department must have exactly one value of triad:name. The value must be an xsd:string (Department.Name)." .

# SQL: Department.Type TEXT
shape:Department-departmentType a sh:PropertyShape ;
    sh:path triad:departmentType ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:departmentType. The value must be an xsd:string (Department.Type)." .

# SQL: Department.PhoneNumber TEXT
shape:Department-phoneNumber a sh:PropertyShape ;
    sh:path triad:phoneNumber ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:phoneNumber. The value must be an xsd:string (Department.PhoneNumber)." .

# SQL: Department.Email TEXT
shape:Department-email a sh:PropertyShape ;
    sh:path triad:email ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:email. The value must be an xsd:string (Department.Email)." .

# SQL: Department.Street TEXT
shape:Department-street a sh:PropertyShape ;
    sh:path triad:street ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:street. The value must be an xsd:string (Department.Street)." .

# SQL: Department.City TEXT
shape:Department-city a sh:PropertyShape ;
    sh:path triad:city ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:city. The value must be an xsd:string (Department.City)." .

# SQL: Department.Region TEXT
shape:Department-region a sh:PropertyShape ;
    sh:path triad:region ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:region. The value must be an xsd:string (Department.Region)." .

# SQL: Department.PostalCode TEXT
shape:Department-postalCode a sh:PropertyShape ;
    sh:path triad:postalCode ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:postalCode. The value must be an xsd:string (Department.PostalCode)." .

# SQL: Department.Country TEXT
shape:Department-country a sh:PropertyShape ;
    sh:path triad:country ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Department can have at most one value of triad:country. The value must be an xsd:string (Department.Country)." .

# SQL: CONSTRAINT UK_Department_Identifier UNIQUE (IdentifierSystem, IdentifierValue)
# triad.ttl: triad:Department owl:hasKey ( triad:identifierSystem triad:identifierValue ).
shape:UK_Department_Identifier a sh:SPARQLConstraint ;
    sh:message "Another triad:Department ({?value}) has the same values of triad:identifierSystem and triad:identifierValue. The key must be unique (UK_Department_Identifier)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:identifierSystem ?key1 ;
                triad:identifierValue ?key2 .
            ?value triad:identifierSystem ?key1 ;
                triad:identifierValue ?key2 ;
                a triad:Department .
            FILTER (?value != $this)
        }
        """ .

