# SQL: CONSTRAINT UK_Location_Identifier UNIQUE (IdentifierSystem, IdentifierValue)
# triad.ttl: triad:Location owl:hasKey ( triad:identifierSystem triad:identifierValue ).
shape:UK_Location_Identifier a sh:SPARQLConstraint ;
    sh:message "Another triad:Location ({?value}) has the same values of triad:identifierSystem and triad:identifierValue. The key must be unique (UK_Location_Identifier)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:identifierSystem ?key1 ;
                triad:identifierValue ?key2 .
            ?value triad:identifierSystem ?key1 ;
                triad:identifierValue ?key2 ;
                a triad:Location .
            FILTER (?value != $this)
        }
        """ .

# --------------------------------------------------------------------------------------------------------------
# triad:Staff (the rows of the table Staff)
# --------------------------------------------------------------------------------------------------------------

shape:StaffShape a sh:NodeShape ;
    sh:targetClass triad:Staff ;
    sh:property
        shape:Staff-identifierSystem ,
        shape:Staff-identifierValue ,
        shape:Staff-name ,
        shape:Staff-staffSex ,
        shape:Staff-email ,
        shape:Staff-phoneNumber ,
        shape:Staff-active ,
        shape:Staff-language ,
        shape:Staff-issues ,
        shape:Staff-inverse-ofStaff ,
        shape:Staff-subtype ;
    sh:sparql shape:UK_Staff_Identifier .

# SQL: Staff.IdentifierSystem TEXT NOT NULL
shape:Staff-identifierSystem a sh:PropertyShape ;
    sh:path triad:identifierSystem ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff must have exactly one value of triad:identifierSystem. The value must be an xsd:string (Staff.IdentifierSystem)." .

# SQL: Staff.IdentifierValue TEXT NOT NULL
shape:Staff-identifierValue a sh:PropertyShape ;
    sh:path triad:identifierValue ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff must have exactly one value of triad:identifierValue. The value must be an xsd:string (Staff.IdentifierValue)." .

# SQL: Staff.Name TEXT NOT NULL
shape:Staff-name a sh:PropertyShape ;
    sh:path triad:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff must have exactly one value of triad:name. The value must be an xsd:string (Staff.Name)." .

# SQL: Staff.Sex TEXT CHECK (Sex IN ('female', 'male', 'other', 'unknown'))
shape:Staff-staffSex a sh:PropertyShape ;
    sh:path triad:staffSex ;
    sh:datatype xsd:string ;
    sh:in ( "female" "male" "other" "unknown" ) ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff can have at most one value of triad:staffSex. The value must be one of: female, male, other, unknown (Staff.Sex)." .

# SQL: Staff.Email TEXT
shape:Staff-email a sh:PropertyShape ;
    sh:path triad:email ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff can have at most one value of triad:email. The value must be an xsd:string (Staff.Email)." .

# SQL: Staff.PhoneNumber TEXT
shape:Staff-phoneNumber a sh:PropertyShape ;
    sh:path triad:phoneNumber ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff can have at most one value of triad:phoneNumber. The value must be an xsd:string (Staff.PhoneNumber)." .

# SQL: Staff.Active INTEGER NOT NULL DEFAULT 1 CHECK (Active IN (0, 1))
shape:Staff-active a sh:PropertyShape ;
    sh:path triad:active ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Staff must have exactly one value of triad:active. The value must be an xsd:boolean (Staff.Active)." .

# SQL: StaffLanguage.Language TEXT NOT NULL
shape:Staff-language a sh:PropertyShape ;
    sh:path triad:language ;
    sh:datatype xsd:string ;
    sh:message "Each triad:Staff can have more than one value of triad:language. Each value must be an xsd:string (StaffLanguage.Language)." .

# SQL: CONSTRAINT FK_Message_StaffId_2_Staff_Id FOREIGN KEY (StaffId) REFERENCES Staff (Id)
shape:Staff-issues a sh:PropertyShape ;
    sh:path triad:issues ;
    sh:class triad:Message ;
    sh:nodeKind sh:IRI ;
    sh:message "Each triad:Staff can have more than one value of triad:issues. Each value must be a triad:Message (Message.StaffId)." .

# No column: new in Milestone 5 (plan 1.3). A staff member works in at least one department. triad.ttl: Staff ⊑ ≥1 inverse(ofStaff).WorksIn.
shape:Staff-inverse-ofStaff a sh:PropertyShape ;
    sh:path [ sh:inversePath triad:ofStaff ] ;
    sh:class triad:WorksIn ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "Each triad:Staff must have at least one triad:WorksIn that links to it with triad:ofStaff (new in Milestone 5)." .

# SQL: Staff.Role TEXT NOT NULL CHECK (Role IN ('Doctor', 'Nurse', 'MOA'))
# SQL: the subtype rows (UK_Doctor_StaffId, UK_Nurse_StaffId, UK_MOA_StaffId).
# The discriminator gives no property: rdf:type holds it (ontology.md section 2).
shape:Staff-subtype a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:qualifiedValueShape [ sh:in ( triad:Doctor triad:Nurse triad:MOA ) ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
    sh:message "Each triad:Staff must have exactly one subtype: triad:Doctor, triad:Nurse or triad:MOA (Staff.Role; the ISA is disjoint and total)." .

# SQL: CONSTRAINT UK_Staff_Identifier UNIQUE (IdentifierSystem, IdentifierValue)
# triad.ttl: triad:Staff owl:hasKey ( triad:identifierSystem triad:identifierValue ).
shape:UK_Staff_Identifier a sh:SPARQLConstraint ;
    sh:message "Another triad:Staff ({?value}) has the same values of triad:identifierSystem and triad:identifierValue. The key must be unique (UK_Staff_Identifier)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:identifierSystem ?key1 ;
                triad:identifierValue ?key2 .
            ?value triad:identifierSystem ?key1 ;
                triad:identifierValue ?key2 ;
                a triad:Staff .
            FILTER (?value != $this)
        }
        """ .

# --------------------------------------------------------------------------------------------------------------
# triad:WorksIn (the rows of the table WorksIn)
# --------------------------------------------------------------------------------------------------------------

shape:WorksInShape a sh:NodeShape ;
    sh:targetClass triad:WorksIn ;
    sh:property
        shape:WorksIn-ofStaff ,
        shape:WorksIn-atDepartment ,
        shape:WorksIn-roleCode ,
        shape:WorksIn-specialty ,
        shape:WorksIn-roleStartDate ,
        shape:WorksIn-roleEndDate ;
    sh:sparql shape:UK_WorksIn_StaffId_DepartmentId_RoleCode .

# SQL: WorksIn.StaffId INTEGER NOT NULL
# SQL: CONSTRAINT FK_WorksIn_StaffId_2_Staff_Id FOREIGN KEY (StaffId) REFERENCES Staff (Id)
shape:WorksIn-ofStaff a sh:PropertyShape ;
    sh:path triad:ofStaff ;
    sh:class triad:Staff ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:WorksIn must have exactly one value of triad:ofStaff. The value must be a triad:Staff (WorksIn.StaffId)." .

# SQL: WorksIn.DepartmentId INTEGER NOT NULL
# SQL: CONSTRAINT FK_WorksIn_DepartmentId_2_Department_Id FOREIGN KEY (DepartmentId) REFERENCES Department (Id)
shape:WorksIn-atDepartment a sh:PropertyShape ;
    sh:path triad:atDepartment ;
    sh:class triad:Department ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:WorksIn must have exactly one value of triad:atDepartment. The value must be a triad:Department (WorksIn.DepartmentId)." .

# SQL: WorksIn.RoleCode TEXT NOT NULL
shape:WorksIn-roleCode a sh:PropertyShape ;
    sh:path triad:roleCode ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:WorksIn must have exactly one value of triad:roleCode. The value must be an xsd:string (WorksIn.RoleCode)." .

# SQL: WorksIn.Specialty TEXT
shape:WorksIn-specialty a sh:PropertyShape ;
    sh:path triad:specialty ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:WorksIn can have at most one value of triad:specialty. The value must be an xsd:string (WorksIn.Specialty)." .

# SQL: WorksIn.StartDate TEXT CHECK (StartDate IS NULL OR julianday(StartDate) IS NOT NULL)
shape:WorksIn-roleStartDate a sh:PropertyShape ;
    sh:path triad:roleStartDate ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:message "Each triad:WorksIn can have at most one value of triad:roleStartDate. The value must be an xsd:date (WorksIn.StartDate)." .

# SQL: WorksIn.EndDate TEXT CHECK (EndDate IS NULL OR julianday(EndDate) IS NOT NULL)
shape:WorksIn-roleEndDate a sh:PropertyShape ;
    sh:path triad:roleEndDate ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:message "Each triad:WorksIn can have at most one value of triad:roleEndDate. The value must be an xsd:date (WorksIn.EndDate)." .

# SQL: CONSTRAINT UK_WorksIn_StaffId_DepartmentId_RoleCode UNIQUE (StaffId, DepartmentId, RoleCode)
# triad.ttl: triad:WorksIn owl:hasKey ( triad:ofStaff triad:atDepartment triad:roleCode ).
shape:UK_WorksIn_StaffId_DepartmentId_RoleCode a sh:SPARQLConstraint ;
    sh:message "Another triad:WorksIn ({?value}) has the same values of triad:ofStaff, triad:atDepartment and triad:roleCode. The key must be unique (UK_WorksIn_StaffId_DepartmentId_RoleCode)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:ofStaff ?key1 ;
                triad:atDepartment ?key2 ;
                triad:roleCode ?key3 .
            ?value triad:ofStaff ?key1 ;
                triad:atDepartment ?key2 ;
                triad:roleCode ?key3 ;
                a triad:WorksIn .
            FILTER (?value != $this)
        }
        """ .

# --------------------------------------------------------------------------------------------------------------
# triad:Doctor (a subtype of triad:Staff: the same individual as its parent row)
# --------------------------------------------------------------------------------------------------------------

shape:DoctorShape a sh:NodeShape ;
    sh:targetClass triad:Doctor ;
    sh:property
        shape:Doctor-licenseNumber ,
        shape:Doctor-qualification ,
        shape:Doctor-type .

# SQL: Doctor.LicenseNumber TEXT
shape:Doctor-licenseNumber a sh:PropertyShape ;
    sh:path triad:licenseNumber ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Doctor can have at most one value of triad:licenseNumber. The value must be an xsd:string (Doctor.LicenseNumber)." .

# SQL: Doctor.Qualification TEXT
shape:Doctor-qualification a sh:PropertyShape ;
    sh:path triad:qualification ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Doctor can have at most one value of triad:qualification. The value must be an xsd:string (Doctor.Qualification)." .

# SQL: Doctor.Role TEXT NOT NULL DEFAULT 'Doctor' CHECK (Role = 'Doctor')
# SQL: CONSTRAINT FK_Doctor_StaffId_Role_2_Staff_Id_Role FOREIGN KEY (StaffId, Role) REFERENCES Staff (Id, Role)
shape:Doctor-type a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:hasValue triad:Staff ;
    sh:message "Each triad:Doctor must also be a triad:Staff: the subtype row and the parent row are one individual (FK_Doctor_StaffId_Role_2_Staff_Id_Role)." .

# --------------------------------------------------------------------------------------------------------------
# triad:Nurse (a subtype of triad:Staff: the same individual as its parent row)
# --------------------------------------------------------------------------------------------------------------

shape:NurseShape a sh:NodeShape ;
    sh:targetClass triad:Nurse ;
    sh:property
        shape:Nurse-licenseNumber ,
        shape:Nurse-designation ,
        shape:Nurse-type .

# SQL: Nurse.LicenseNumber TEXT
shape:Nurse-licenseNumber a sh:PropertyShape ;
    sh:path triad:licenseNumber ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:Nurse can have at most one value of triad:licenseNumber. The value must be an xsd:string (Nurse.LicenseNumber)." .

# SQL: Nurse.Designation TEXT NOT NULL CHECK (Designation IN ('RN', 'LPN', 'RPN', 'NP'))
shape:Nurse-designation a sh:PropertyShape ;
    sh:path triad:designation ;
    sh:datatype xsd:string ;
    sh:in ( "RN" "LPN" "RPN" "NP" ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each triad:Nurse must have exactly one value of triad:designation. The value must be one of: RN, LPN, RPN, NP (Nurse.Designation)." .

# SQL: Nurse.Role TEXT NOT NULL DEFAULT 'Nurse' CHECK (Role = 'Nurse')
# SQL: CONSTRAINT FK_Nurse_StaffId_Role_2_Staff_Id_Role FOREIGN KEY (StaffId, Role) REFERENCES Staff (Id, Role)
shape:Nurse-type a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:hasValue triad:Staff ;
    sh:message "Each triad:Nurse must also be a triad:Staff: the subtype row and the parent row are one individual (FK_Nurse_StaffId_Role_2_Staff_Id_Role)." .

# --------------------------------------------------------------------------------------------------------------
