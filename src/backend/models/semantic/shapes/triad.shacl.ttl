    sh:message "Each triad:MOA must have exactly one value of triad:desk. The value must be an xsd:string (MOA.Desk)." .

# SQL: MOA.PhoneExtension TEXT
shape:MOA-phoneExtension a sh:PropertyShape ;
    sh:path triad:phoneExtension ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each triad:MOA can have at most one value of triad:phoneExtension. The value must be an xsd:string (MOA.PhoneExtension)." .

