# SQL: CONSTRAINT UK_Patient_Name_DateOfBirth UNIQUE (Name, DateOfBirth)
# triad.ttl: triad:Patient owl:hasKey ( triad:name triad:dateOfBirth ).
shape:UK_Patient_Name_DateOfBirth a sh:SPARQLConstraint ;
    sh:message "Another triad:Patient ({?value}) has the same values of triad:name and triad:dateOfBirth. The key must be unique (UK_Patient_Name_DateOfBirth)." ;
    sh:prefixes <https://github.com/MohamedKhalidmk/TRIAD/shapes/triad> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this triad:name ?key1 ;
                triad:dateOfBirth ?key2 .
            ?value triad:name ?key1 ;
                triad:dateOfBirth ?key2 ;
                a triad:Patient .
            FILTER (?value != $this)
        }
        """ .

