# TRIAD frontend settings. dev.sh copies this file to .env if .env does not exist.
# Git ignores .env. A variable of the shell wins over .env.
#
# WARNING: the build puts each VITE_ value into the JavaScript bundle. Each user of the app can read it.
# Never put an API key or another secret in this folder. The secrets go in src/backend/.env.
#
# The values are read when Vite starts (npm run dev) or builds (npm run build).
# After you change them, start Vite again or make a new build.

# The backend that the Vite dev server sends each /api request to. Only the dev server reads it.
# It does not go into the bundle. dev.sh sets it from PORT, so change it only if you start
# the frontend alone (npm run dev) with a backend at a different address.
TRIAD_API_URL=http://127.0.0.1:8000

# A public value that the app can read as import.meta.env.VITE_EXAMPLE.
# Declare each VITE_ value in src/vite-env.d.ts.
# VITE_EXAMPLE=
